---
{
  "name": "Omnissa Horizon 8 2603 — Horizon Recording Server",
  "notes": "<h4>Horizon Recording Server Notes</h4><p><em>As of June 2026 — verify against current Omnissa Horizon 8 2603 documentation before deployment.</em></p><ul><li><b>Availability:</b> Horizon Recording has been available since Horizon 8 2106 (VDI recording; RDSH recording from 2111, Linux agent from 2306) and is included in 8 2603.</li><li><b>Recording data (9443):</b> The Recording Agent on the desktop / RDS host transmits application data to the Recording Server over TLS on TCP 9443. The web console and recording-server-to-recording-server configuration import also use 9443.</li><li><b>Database:</b> {{#if (eq recordingDb \"postgres\")}}PostgreSQL on 5432 (default).{{else}}Microsoft SQL on 1433 (default).{{/if}}</li><li><b>Source note:</b> The published port table lists the Microsoft SQL port as 1443, but its own service description states the default is 1433; this diagram uses 1433.</li>{{#if ldapsAuth}}<li><b>Web console login:</b> LDAPS (TCP 636) is used when Active Directory is integrated for web console authentication.</li>{{/if}}<li>References: <a href=\"https://techzone.omnissa.com/resource/network-ports-horizon-8\" target=\"_blank\" rel=\"noopener\">Network Ports in Horizon 8 (Omnissa Tech Zone)</a>, <a href=\"https://ports.omnissa.com/home/Horizon\" target=\"_blank\" rel=\"noopener\">Omnissa Ports and Protocols</a>, and <a href=\"https://docs.omnissa.com/bundle/Desktops-and-Applications-in-HorizonV2603/page/UsingHorizonRecording.html\" target=\"_blank\" rel=\"noopener\">Using Horizon Recording (2603)</a>.</li></ul>",
  "parameters": [
    { "key": "rsName", "type": "string", "label": "Recording Server Hostname", "defaultValue": "rs1.example.com" },
    { "key": "rsIP", "type": "string", "label": "Recording Server IP", "defaultValue": "10.10.10.30" },
    { "key": "additionalComments", "type": "string", "label": "Additional Node Comments", "defaultValue": "" },
    { "key": "recordingDb", "type": "select", "label": "Recording Database", "defaultValue": "postgres", "options": [
      { "label": "PostgreSQL (5432)", "value": "postgres" },
      { "label": "Microsoft SQL (1433)", "value": "mssql" }
    ] },
    { "key": "ldapsAuth", "type": "boolean", "label": "AD LDAPS Web Console Login (636)", "defaultValue": false },
    { "key": "multiServer", "type": "boolean", "label": "Multi-Server Config Import (9443)", "defaultValue": false },
    { "key": "includeFooterInChart", "type": "boolean", "label": "Include Footer Notes in Chart", "defaultValue": false }
  ]
}
---
graph TD
    %% ═══════════════════════════════════════
    %%  MANAGEMENT
    %% ═══════════════════════════════════════
    subgraph EXT[Management]
        ADMIN[👤 Web Console Browser]
    end

    %% ═══════════════════════════════════════
    %%  INTERNAL ZONE
    %% ═══════════════════════════════════════
    subgraph INT[Internal Network]
        RS[<b>Horizon Recording Server</b><br/>Horizon 8 2603<br/>{{rsName}} — {{rsIP}}{{#if additionalComments}}<br/><i>{{additionalComments}}</i>{{/if}}]
        RAGENT[🖥️ Recording Agent — Desktop / RDS]
        DB[(🗄️ {{#if (eq recordingDb "postgres")}}PostgreSQL{{else}}Microsoft SQL{{/if}})]
        {{#if ldapsAuth}}
        AD[🗄️ Active Directory]
        {{/if}}
        {{#if multiServer}}
        RS2[🔁 Peer Recording Server]
        {{/if}}
    end

    %% ═══════════════════════════════════════
    %%  RECORDING DATA — Agent → Server
    %% ═══════════════════════════════════════
    RAGENT -->|9443 TCP TLS<br/>Recording application data| RS

    %% ═══════════════════════════════════════
    %%  WEB CONSOLE
    %% ═══════════════════════════════════════
    ADMIN -->|9443 TCP<br/>Recording Server web console| RS

    %% ═══════════════════════════════════════
    %%  DATABASE
    %% ═══════════════════════════════════════
    {{#if (eq recordingDb "postgres")}}
    RS -->|5432 TCP<br/>PostgreSQL| DB
    {{else}}
    RS -->|1433 TCP<br/>Microsoft SQL| DB
    {{/if}}

    %% ═══════════════════════════════════════
    %%  DIRECTORY (web console login)
    %% ═══════════════════════════════════════
    {{#if ldapsAuth}}
    RS -->|636 TCP<br/>LDAPS web console login| AD
    {{/if}}

    %% ═══════════════════════════════════════
    %%  MULTI-SERVER CONFIG IMPORT
    %% ═══════════════════════════════════════
    {{#if multiServer}}
    RS -->|9443 TCP<br/>Configuration import| RS2
    {{/if}}

    %% ═══════════════════════════════════════
    %%  FOOTER NOTES (in-diagram)
    %% ═══════════════════════════════════════
    {{#if includeFooterInChart}}
    RS ~~~ NOTES
    NOTES[<b>Horizon Recording Server Notes</b><br/>As of June 2026<br/>Recording Agent → Server — 9443 TLS<br/>Web console — 9443<br/>Database — {{#if (eq recordingDb "postgres")}}PostgreSQL 5432{{else}}Microsoft SQL 1433{{/if}}{{#if ldapsAuth}}<br/>Web console login — LDAPS 636{{/if}}{{#if multiServer}}<br/>Config import — 9443 peer{{/if}}]
    style NOTES fill:#263238,color:#cfd8dc,stroke:#455a64,stroke-width:1px
    {{/if}}

    %% ═══════════════════════════════════════
    %%  STYLES
    %% ═══════════════════════════════════════
    style RS fill:#1565c0,color:#fff,stroke:#0d47a1,stroke-width:2px
    style EXT fill:#eceff1,color:#000,stroke:#607d8b
    style INT fill:#e8f5e9,color:#000,stroke:#2e7d32
