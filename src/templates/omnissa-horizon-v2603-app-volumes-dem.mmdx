---
{
  "name": "Omnissa Horizon 8 2603 — App Volumes Manager & DEM",
  "notes": "<h4>App Volumes Manager &amp; Dynamic Environment Manager Notes</h4><p><em>As of June 2026 — verify against current Omnissa Horizon 8 2603 documentation before deployment.</em></p><ul><li><b>App Volumes Agent → Manager:</b> {{#if avSSL}}TCP 443 (SSL){{else}}TCP 80 (no SSL certificate){{/if}} for the agent-to-manager channel.</li><li><b>App Volumes Manager → infrastructure:</b> vCenter Server SOAP on 443, ESXi hostd on 443, and the App Volumes database (Microsoft SQL) on 1433.</li>{{#if enableDEM}}<li><b>Dynamic Environment Manager:</b> The DEM FlexEngine on the desktop / RDS host accesses SMB file shares on TCP 445.</li>{{/if}}<li>These services run on the same virtual desktop / RDS hosts as the Horizon Agent; see the Horizon Agent diagram for session traffic.</li><li>Reference: Omnissa Horizon 8 2603 — Network Ports for App Volumes and Dynamic Environment Manager.</li></ul>",
  "parameters": [
    { "key": "avName", "type": "string", "label": "App Volumes Manager Hostname", "defaultValue": "av1.example.com" },
    { "key": "avIP", "type": "string", "label": "App Volumes Manager IP", "defaultValue": "10.10.10.40" },
    { "key": "additionalComments", "type": "string", "label": "Additional Node Comments", "defaultValue": "" },
    { "key": "avSSL", "type": "boolean", "label": "Agent → Manager over SSL (443 vs 80)", "defaultValue": true },
    { "key": "showEsxi", "type": "boolean", "label": "Show ESXi Hosts (443 hostd)", "defaultValue": true },
    { "key": "enableDEM", "type": "boolean", "label": "Dynamic Environment Manager (445)", "defaultValue": true },
    { "key": "includeFooterInChart", "type": "boolean", "label": "Include Footer Notes in Chart", "defaultValue": false }
  ]
}
---
graph TD
    %% ═══════════════════════════════════════
    %%  MANAGEMENT
    %% ═══════════════════════════════════════
    subgraph EXT[Management]
        ADMIN[👤 Admin Console Browser]
    end

    %% ═══════════════════════════════════════
    %%  VIRTUAL DESKTOP / RDS HOST
    %% ═══════════════════════════════════════
    subgraph HOST[Virtual Desktop / RDS Host]
        AVAGENT[📦 App Volumes Agent]
        {{#if enableDEM}}
        DEMFLEX[⚙️ DEM FlexEngine]
        {{/if}}
    end

    %% ═══════════════════════════════════════
    %%  INTERNAL ZONE
    %% ═══════════════════════════════════════
    subgraph INT[Internal Network]
        AVMGR[<b>App Volumes Manager</b><br/>Horizon 8 2603<br/>{{avName}} — {{avIP}}{{#if additionalComments}}<br/><i>{{additionalComments}}</i>{{/if}}]
        VCENTER[(🗄️ vCenter Server)]
        {{#if showEsxi}}
        ESXI[🖥️ ESXi Hosts]
        {{/if}}
        DB[(🗄️ App Volumes Database)]
        {{#if enableDEM}}
        FILESHARES[📂 SMB / CIFS File Shares]
        {{/if}}
    end

    %% ═══════════════════════════════════════
    %%  ADMINISTRATION
    %% ═══════════════════════════════════════
    ADMIN -->|443 TCP<br/>App Volumes Manager console| AVMGR

    %% ═══════════════════════════════════════
    %%  AGENT → MANAGER
    %% ═══════════════════════════════════════
    AVAGENT -->|{{#if avSSL}}443 TCP{{else}}80 TCP{{/if}}<br/>Agent → Manager| AVMGR

    %% ═══════════════════════════════════════
    %%  MANAGER → INFRASTRUCTURE
    %% ═══════════════════════════════════════
    AVMGR -->|443 TCP<br/>vCenter SOAP| VCENTER
    {{#if showEsxi}}
    AVMGR -->|443 TCP<br/>ESXi hostd| ESXI
    {{/if}}
    AVMGR -->|1433 TCP<br/>Microsoft SQL| DB

    %% ═══════════════════════════════════════
    %%  DYNAMIC ENVIRONMENT MANAGER
    %% ═══════════════════════════════════════
    {{#if enableDEM}}
    DEMFLEX -->|445 TCP<br/>SMB file shares| FILESHARES
    {{/if}}

    %% ═══════════════════════════════════════
    %%  FOOTER NOTES (in-diagram)
    %% ═══════════════════════════════════════
    {{#if includeFooterInChart}}
    AVMGR ~~~ NOTES
    NOTES[<b>App Volumes & DEM Notes</b><br/>As of June 2026<br/>Agent → Manager — {{#if avSSL}}443{{else}}80{{/if}}<br/>Manager → vCenter / ESXi — 443<br/>Manager → SQL — 1433{{#if enableDEM}}<br/>DEM FlexEngine → SMB — 445{{/if}}]
    style NOTES fill:#263238,color:#cfd8dc,stroke:#455a64,stroke-width:1px
    {{/if}}

    %% ═══════════════════════════════════════
    %%  STYLES
    %% ═══════════════════════════════════════
    style AVMGR fill:#1565c0,color:#fff,stroke:#0d47a1,stroke-width:2px
    style EXT fill:#eceff1,color:#000,stroke:#607d8b
    style HOST fill:#e8eaf6,color:#000,stroke:#3949ab
    style INT fill:#e8f5e9,color:#000,stroke:#2e7d32
