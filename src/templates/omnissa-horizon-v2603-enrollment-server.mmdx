---
{
  "name": "Omnissa Horizon 8 2603 — True SSO Enrollment Server",
  "notes": "<h4>True SSO Enrollment Server Notes</h4><p><em>As of July 2026 — verify against current Omnissa Horizon 8 2603 documentation before deployment.</em></p><ul><li><b>Framework channel (32111):</b> Each paired Connection Server communicates with the Enrollment Server over TCP 32111. Deploy more than one Enrollment Server for redundancy.</li><li><b>Certificate request:</b> The Enrollment Service uses TCP 135 (RPC) for the initial communication with the Certificate Authority, then a random dynamic port from the 1024-5000 and 49152-65535 ranges (published as one combined requirement), to generate a temporary, short-lived certificate. The diagram currently shows {{#if (eq rpcRange \"both\")}}both ranges, as published{{else}}{{#if (eq rpcRange \"modern\")}}49152-65535 only{{else}}1024-5000 only{{/if}} — a single-range view for deployments that have pinned or restricted the Windows dynamic port range{{/if}}. See Certificate Services in MS KB 832017.</li><li><b>Active Directory:</b> The Enrollment Server communicates with domain controllers using all relevant ports to discover a DC and to bind and query Active Directory. See MS KB 832017.</li><li><b>Source note:</b> The <a href=\"https://ports.omnissa.com/home/Horizon\" target=\"_blank\" rel=\"noopener\">ports.omnissa.com</a> Horizon entry's Enrollment Server → AD Certificate Services row (checked 2026-07-10) prints the dynamic range as &quot;4192-65535&quot;; this is a typo for 49152-65535 (cf. the <a href=\"https://techzone.omnissa.com/resource/network-ports-horizon-8\" target=\"_blank\" rel=\"noopener\">Tech Zone Horizon 8 port guide</a> and MS KB 832017). This template uses the correct range.</li><li>References: <a href=\"https://docs.omnissa.com/bundle/Horizon-Security/page/Horizon8TrueSSOPorts.html\" target=\"_blank\" rel=\"noopener\">Horizon 8 TrueSSO Ports (2303 and later)</a> and <a href=\"https://ports.omnissa.com/home/Horizon\" target=\"_blank\" rel=\"noopener\">Omnissa Ports and Protocols</a>.</li></ul>",
  "parameters": [
    { "key": "esName", "type": "string", "label": "Enrollment Server Hostname", "defaultValue": "es1.example.com" },
    { "key": "esIP", "type": "string", "label": "Enrollment Server IP", "defaultValue": "10.10.10.20" },
    { "key": "additionalComments", "type": "string", "label": "Additional Node Comments", "defaultValue": "" },
    { "key": "pairedCSCount", "type": "number", "label": "Paired Connection Servers", "defaultValue": 2, "validation": { "min": 1 } },
    { "key": "rpcRange", "type": "select", "label": "CA Dynamic RPC Range", "defaultValue": "both", "options": [
      { "label": "Both — 1024-5000 and 49152-65535 (as published)", "value": "both" },
      { "label": "Modern (49152-65535)", "value": "modern" },
      { "label": "Legacy (1024-5000)", "value": "legacy" }
    ] },
    { "key": "showADPorts", "type": "boolean", "label": "Expand AD Domain Controller Ports", "defaultValue": true },
    { "key": "includeFooterInChart", "type": "boolean", "label": "Include Footer Notes in Chart", "defaultValue": false }
  ]
}
---
graph TD
    %% ═══════════════════════════════════════
    %%  HORIZON POD
    %% ═══════════════════════════════════════
    subgraph POD[Horizon Pod]
        CS[🖥️ Connection Servers<br/>× {{pairedCSCount}}]
    end

    %% ═══════════════════════════════════════
    %%  ENROLLMENT SERVER
    %% ═══════════════════════════════════════
    ES[<b>Horizon Enrollment Server</b><br/>True SSO — Horizon 8 2603<br/>{{esName}} — {{esIP}}{{#if additionalComments}}<br/><i>{{additionalComments}}</i>{{/if}}]

    %% ═══════════════════════════════════════
    %%  ACTIVE DIRECTORY & PKI
    %% ═══════════════════════════════════════
    subgraph ADPKI[Active Directory & PKI]
        CA[🔏 AD Certificate Services]
        DC[🗄️ AD Domain Controllers]
    end

    %% ═══════════════════════════════════════
    %%  CONNECTION SERVER → ENROLLMENT SERVER
    %% ═══════════════════════════════════════
    CS -->|32111 TCP<br/>Framework channel| ES

    %% ═══════════════════════════════════════
    %%  ENROLLMENT SERVER → CERTIFICATE AUTHORITY
    %% ═══════════════════════════════════════
    ES -->|135 TCP RPC then {{#if (eq rpcRange "both")}}1024-5000, 49152-65535{{else}}{{#if (eq rpcRange "modern")}}49152-65535{{else}}1024-5000{{/if}}{{/if}}<br/>Short-lived cert request| CA

    %% ═══════════════════════════════════════
    %%  ENROLLMENT SERVER → DOMAIN CONTROLLERS
    %% ═══════════════════════════════════════
    {{#if showADPorts}}
    ES -->|53 TCP+UDP<br/>DNS| DC
    ES -->|88 TCP+UDP<br/>Kerberos| DC
    ES -->|135 TCP<br/>RPC then 49152-65535| DC
    ES -->|389 TCP+UDP<br/>LDAP| DC
    ES -->|445 TCP<br/>SMB| DC
    ES -->|464 TCP+UDP<br/>Kerberos password| DC
    ES -->|636 TCP<br/>LDAPS| DC
    ES -->|3268 TCP<br/>Global Catalog| DC
    ES -->|3269 TCP<br/>Global Catalog SSL| DC
    {{else}}
    ES -->|All relevant AD ports<br/>DC discovery / bind / query| DC
    {{/if}}

    %% ═══════════════════════════════════════
    %%  FOOTER NOTES (in-diagram)
    %% ═══════════════════════════════════════
    {{#if includeFooterInChart}}
    ES ~~~ NOTES
    NOTES[<b>True SSO Notes</b><br/>As of July 2026<br/>CS → ES framework channel — 32111<br/>ES → CA — 135 RPC then {{#if (eq rpcRange "both")}}1024-5000, 49152-65535{{else}}{{#if (eq rpcRange "modern")}}49152-65535{{else}}1024-5000{{/if}}{{/if}}<br/>ES → DC — {{#if showADPorts}}88, 389, 636, 3268, 3269, 445, 464, 135 then 49152-65535, 53{{else}}all relevant AD ports{{/if}}<br/>Short-lived certificate for SSO<br/>Deploy 2+ Enrollment Servers for redundancy]
    style NOTES fill:#263238,color:#cfd8dc,stroke:#455a64,stroke-width:1px
    {{/if}}

    %% ═══════════════════════════════════════
    %%  STYLES
    %% ═══════════════════════════════════════
    style ES fill:#1565c0,color:#fff,stroke:#0d47a1,stroke-width:2px
    style POD fill:#e8eaf6,color:#000,stroke:#3949ab
    style ADPKI fill:#f3e5f5,color:#000,stroke:#7b1fa2
