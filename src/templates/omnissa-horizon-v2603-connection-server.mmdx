---
{
  "name": "Omnissa Horizon 8 2603 — Connection Server",
  "notes": "<h4>Connection Server — Control Plane Notes</h4><p><em>As of June 2026 — verify against current Omnissa Horizon 8 2603 documentation before deployment.</em></p><ul><li><b>JMS:</b> Agents and replica Connection Servers communicate over JMS. Enhanced security (JMS over SSL, TCP 4002 / 4101) is the default; legacy 4001 / 4100 is shown for reference.</li><li><b>Replica install:</b> TCP 389 and 32111 (cluster master secret) are only required while installing/rekeying a replica Connection Server.</li>{{#if enableCPA}}<li><b>Cloud Pod Architecture:</b> Global LDAP replication on 22389 (ADLDS), inter-pod VIPA on 8472, and MS-RPC on 135 plus the dynamic client range 49152-65535.</li>{{/if}}<li><b>Events database:</b> {{#if (eq eventsDb \"mssql\")}}Microsoft SQL on 1433 (default).{{/if}}{{#if (eq eventsDb \"oracle\")}}Oracle on 1521.{{/if}}{{#if (eq eventsDb \"none\")}}No events database configured.{{/if}}</li>{{#if splitMgmtTraffic}}<li><b>Split management traffic:</b> Suggested port 9443 separates REST API / View API / Horizon Console from user traffic. Available in 8 2412 and later.</li>{{/if}}{{#if (or radiusAuth rsaSecurID)}}<li><b>Two-factor auth:</b> RADIUS / RSA SecurID default to UDP 5500 but the port is configurable.</li>{{/if}}{{#if (or monitorAppVolumes monitorUAG)}}<li><b>Monitoring:</b> The vRealize Operations for Horizon broker agent monitors App Volumes Managers (443) and Unified Access Gateway appliances (9443).</li>{{/if}}{{#if enableHCC}}<li><b>Horizon Cloud Connector:</b> Reaches the Omnissa Cloud Service over 443 (cloud.horizon.omnissa.com) and integrates with the Connection Server over 443.</li>{{/if}}<li>Display-protocol session traffic (Blast / PCoIP / RDP) is covered in the companion Horizon Agent diagram; the external client edge detail is covered in the UAG 2603 diagram.</li><li>Reference: Omnissa Horizon 8 2603 — Network Ports for Horizon Connection Server.</li></ul>",
  "parameters": [
    { "key": "csName", "type": "string", "label": "Connection Server Hostname", "defaultValue": "cs1.example.com" },
    { "key": "csIP", "type": "string", "label": "Connection Server IP", "defaultValue": "10.10.10.10" },
    { "key": "additionalComments", "type": "string", "label": "Additional Node Comments", "defaultValue": "" },
    { "key": "showFirewalls", "type": "boolean", "label": "Show Perimeter / Back-End Firewalls", "defaultValue": true },

    { "key": "enableReplica", "type": "boolean", "label": "Replica Connection Server (cluster)", "defaultValue": true },
    { "key": "replicaCount", "type": "number", "label": "Replica Count", "defaultValue": 2, "validation": { "min": 1 }, "showWhen": { "key": "enableReplica", "value": true } },

    { "key": "enableCPA", "type": "boolean", "label": "Cloud Pod Architecture (CPA)", "defaultValue": false },

    { "key": "eventsDb", "type": "select", "label": "Events Database", "defaultValue": "mssql", "options": [
      { "label": "Microsoft SQL (1433)", "value": "mssql" },
      { "label": "Oracle (1521)", "value": "oracle" },
      { "label": "None", "value": "none" }
    ] },

    { "key": "enableEnrollmentServer", "type": "boolean", "label": "TrueSSO Enrollment Server (32111)", "defaultValue": false },

    { "key": "enableVCenter", "type": "boolean", "label": "vCenter Server", "defaultValue": true },
    { "key": "showEsxi", "type": "boolean", "label": "Show ESXi Hosts (902)", "defaultValue": true, "showWhen": { "key": "enableVCenter", "value": true } },

    { "key": "radiusAuth", "type": "boolean", "label": "RADIUS Auth via UAG (5500 UDP)", "defaultValue": false },
    { "key": "rsaSecurID", "type": "boolean", "label": "RSA SecurID (5500 UDP)", "defaultValue": false },

    { "key": "enableHCC", "type": "boolean", "label": "Horizon Cloud Connector", "defaultValue": false },

    { "key": "monitorAppVolumes", "type": "boolean", "label": "vROps Monitoring — App Volumes (443)", "defaultValue": false },
    { "key": "monitorUAG", "type": "boolean", "label": "vROps Monitoring — UAG (9443)", "defaultValue": false },

    { "key": "htmlAccess", "type": "boolean", "label": "HTML Access (8443)", "defaultValue": true },
    { "key": "splitMgmtTraffic", "type": "boolean", "label": "Split Management Traffic (9443, 2412+)", "defaultValue": false },
    { "key": "tunneledGateway", "type": "boolean", "label": "Tunneled Gateway on CS (BSG 8443 / PSG 4172)", "defaultValue": false },

    { "key": "includeFooterInChart", "type": "boolean", "label": "Include Footer Notes in Chart", "defaultValue": false }
  ]
}
---
%%{init: {"flowchart": {"nodeSpacing": 65, "rankSpacing": 95}}}%%
graph TD
    %% ═══════════════════════════════════════
    %%  EXTERNAL ZONE
    %% ═══════════════════════════════════════
    subgraph EXT[External Network]
        CLIENT_EXT[🌐 External Horizon Clients]
        ADMIN[👤 Admin / Console Browser]
    end

    %% ═══════════════════════════════════════
    %%  PERIMETER FIREWALL
    %% ═══════════════════════════════════════
    {{#if showFirewalls}}
    FFW{🛡️ Perimeter Firewall}
    {{/if}}

    %% ═══════════════════════════════════════
    %%  DMZ ZONE
    %% ═══════════════════════════════════════
    subgraph DMZ[DMZ]
        UAG[🛡️ Unified Access Gateway]
    end

    %% ═══════════════════════════════════════
    %%  BACK-END FIREWALL
    %% ═══════════════════════════════════════
    {{#if showFirewalls}}
    BFW{🛡️ Back-End Firewall}
    {{/if}}

    %% ═══════════════════════════════════════
    %%  INTERNAL ZONE
    %% ═══════════════════════════════════════
    subgraph INT[Internal Network]
        CS[<b>Horizon Connection Server</b><br/>Horizon 8 2603<br/>{{csName}} — {{csIP}}{{#if additionalComments}}<br/><i>{{additionalComments}}</i>{{/if}}]
        CLIENT_INT[💻 Internal Horizon Clients]
        AGENT[🖥️ Horizon Agent — Desktop / RDS]
        {{#if enableReplica}}
        CS_REPLICA[🔁 Replica Connection Server<br/>× {{replicaCount}}]
        {{/if}}
        {{#if enableCPA}}
        CS_CPA[🌐 CPA Peer Pod<br/>Connection Server]
        {{/if}}
        {{#if enableVCenter}}
        VCENTER[(🗄️ vCenter Server)]
        {{#if showEsxi}}
        ESXI[🖥️ ESXi Hosts]
        {{/if}}
        {{/if}}
        {{#unless (eq eventsDb "none")}}
        DB[(🗄️ Events Database)]
        {{/unless}}
        {{#if enableEnrollmentServer}}
        ENROLL[🔐 Enrollment Server]
        {{/if}}
        {{#if rsaSecurID}}
        RSA[🔑 RSA SecurID Auth Mgr]
        {{/if}}
        {{#if radiusAuth}}
        RADIUS[🔑 RADIUS Server]
        {{/if}}
        {{#if monitorAppVolumes}}
        AVMGR[📦 App Volumes Manager]
        {{/if}}
    end

    %% ═══════════════════════════════════════
    %%  CLOUD INTEGRATIONS
    %% ═══════════════════════════════════════
    {{#if enableHCC}}
    HCC[☁️ Horizon Cloud Connector]
    OMNISSA_CLOUD[☁️ Omnissa Cloud Service]
    {{/if}}

    %% ═══════════════════════════════════════
    %%  FIREWALL BOUNDARY ANCHORS
    %% ═══════════════════════════════════════
    {{#if showFirewalls}}
    CLIENT_EXT ~~~ FFW
    FFW ~~~ UAG
    UAG ~~~ BFW
    %% Anchor the back-end firewall above every internal source node so it
    %% sits on its own band between the DMZ and the Internal Network rather
    %% than level with the clients/agent that point into the Connection Server.
    BFW ~~~ CS
    BFW ~~~ CLIENT_INT
    BFW ~~~ AGENT
    {{/if}}

    %% ═══════════════════════════════════════
    %%  EXTERNAL ACCESS — Client → UAG → CS
    %% ═══════════════════════════════════════
    CLIENT_EXT -->|443 TCP+UDP<br/>Login + display protocols| UAG
    UAG -->|443 TCP<br/>External client login| CS
    {{#if radiusAuth}}
    UAG -.->|5500 UDP<br/>RADIUS auth — configurable| RADIUS
    {{/if}}

    %% ═══════════════════════════════════════
    %%  INTERNAL CLIENT ACCESS
    %% ═══════════════════════════════════════
    CLIENT_INT -->|443 TCP — Login / authentication{{#if htmlAccess}}<br/>8443 TCP — HTML Access via browser{{/if}}{{#if tunneledGateway}}<br/>8443 TCP — Blast via BSG on CS<br/>4172 TCP+UDP — PCoIP via PSG on CS{{/if}}| CS

    %% ═══════════════════════════════════════
    %%  ADMINISTRATION
    %% ═══════════════════════════════════════
    ADMIN -->|443 TCP<br/>Admin console — /admin /newadmin| CS
    {{#if splitMgmtTraffic}}
    ADMIN -->|9443 TCP<br/>Console split-mgmt — 2412+| CS
    {{/if}}
    {{#if enableVCenter}}
    ADMIN -->|443 TCP<br/>vSphere Client| VCENTER
    {{/if}}

    %% ═══════════════════════════════════════
    %%  AGENT → CS (JMS)
    %% ═══════════════════════════════════════
    AGENT -->|4001 TCP — 4002 JMS SSL<br/>Agent JMS| CS

    %% ═══════════════════════════════════════
    %%  CS ↔ CS REPLICATION
    %% ═══════════════════════════════════════
    {{#if enableReplica}}
    CS -->|4100 TCP — 4101 JMS SSL — CS-CS state<br/>389, 32111 TCP — replica install / rekey| CS_REPLICA
    {{/if}}

    %% ═══════════════════════════════════════
    %%  CLOUD POD ARCHITECTURE
    %% ═══════════════════════════════════════
    {{#if enableCPA}}
    CS -->|22389 TCP — Global LDAP / ADLDS<br/>8472 TCP — Inter-pod VIPA<br/>135, 49152-65535 TCP — MS-RPC| CS_CPA
    {{/if}}

    %% ═══════════════════════════════════════
    %%  EVENTS DATABASE
    %% ═══════════════════════════════════════
    {{#if (eq eventsDb "mssql")}}
    CS -->|1433 TCP<br/>Events DB — Microsoft SQL| DB
    {{/if}}
    {{#if (eq eventsDb "oracle")}}
    CS -->|1521 TCP<br/>Events DB — Oracle| DB
    {{/if}}

    %% ═══════════════════════════════════════
    %%  VIRTUAL INFRASTRUCTURE
    %% ═══════════════════════════════════════
    {{#if enableVCenter}}
    CS -->|443 TCP<br/>vCenter SOAP| VCENTER
    {{#if showEsxi}}
    VCENTER -->|902 TCP<br/>ESXi SOAP| ESXI
    {{/if}}
    {{/if}}

    %% ═══════════════════════════════════════
    %%  TRUESSO ENROLLMENT
    %% ═══════════════════════════════════════
    {{#if enableEnrollmentServer}}
    CS -->|32111 TCP<br/>Framework channel| ENROLL
    {{/if}}

    %% ═══════════════════════════════════════
    %%  AUTHENTICATION
    %% ═══════════════════════════════════════
    {{#if rsaSecurID}}
    CS -.->|5500 UDP<br/>RSA SecurID — configurable| RSA
    {{/if}}

    %% ═══════════════════════════════════════
    %%  HORIZON CLOUD CONNECTOR
    %% ═══════════════════════════════════════
    {{#if enableHCC}}
    HCC -->|443 TCP<br/>Cloud Connector → CS| CS
    HCC -->|443 TCP<br/>Omnissa Cloud Service| OMNISSA_CLOUD
    ADMIN -->|443 TCP<br/>Admin access to HCC| HCC
    {{/if}}

    %% ═══════════════════════════════════════
    %%  MONITORING — vROps broker agent
    %% ═══════════════════════════════════════
    {{#if monitorAppVolumes}}
    CS -.->|443 TCP<br/>vROps broker agent — AV Mgr| AVMGR
    {{/if}}
    {{#if monitorUAG}}
    CS -.->|9443 TCP<br/>vROps broker agent — UAG| UAG
    {{/if}}

    %% ═══════════════════════════════════════
    %%  FOOTER NOTES (in-diagram)
    %% ═══════════════════════════════════════
    {{#if includeFooterInChart}}
    CS ~~~ NOTES
    NOTES[<b>Connection Server Notes</b><br/>As of June 2026<br/>JMS enhanced security default — 4002 / 4101<br/>Replica install only — 389, 32111<br/>{{#if enableCPA}}CPA — 22389, 8472, 135, 49152-65535<br/>{{/if}}Events DB — {{#if (eq eventsDb "mssql")}}MS SQL 1433{{/if}}{{#if (eq eventsDb "oracle")}}Oracle 1521{{/if}}{{#if (eq eventsDb "none")}}none{{/if}}{{#if splitMgmtTraffic}}<br/>Split-mgmt 9443 — 8 2412+{{/if}}{{#if (or radiusAuth rsaSecurID)}}<br/>2FA 5500 UDP — configurable{{/if}}{{#if enableHCC}}<br/>HCC → Omnissa Cloud 443{{/if}}]
    style NOTES fill:#263238,color:#cfd8dc,stroke:#455a64,stroke-width:1px
    {{/if}}

    %% ═══════════════════════════════════════
    %%  STYLES
    %% ═══════════════════════════════════════
    style CS fill:#1565c0,color:#fff,stroke:#0d47a1,stroke-width:2px
    style EXT fill:#eceff1,color:#000,stroke:#607d8b
    style DMZ fill:#fff3e0,color:#000,stroke:#ef6c00,stroke-width:2px
    style INT fill:#e8f5e9,color:#000,stroke:#2e7d32
    {{#if showFirewalls}}
    style FFW fill:#ffebee,color:#b71c1c,stroke:#c62828,stroke-width:2px
    style BFW fill:#ffebee,color:#b71c1c,stroke:#c62828,stroke-width:2px
    {{/if}}
    {{#if enableHCC}}
    style HCC fill:#e8f5e9,color:#1b5e20,stroke:#2e7d32
    style OMNISSA_CLOUD fill:#e8f5e9,color:#1b5e20,stroke:#2e7d32
    {{/if}}
